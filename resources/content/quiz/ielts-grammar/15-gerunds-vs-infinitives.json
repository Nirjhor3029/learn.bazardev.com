    "q": {
      "en": "Which sentence recalls a memory of an already-completed action?",
      "bn": "কোন sentence একটা আগেই শেষ হওয়া কাজের memory recall করে?"
    },
    "options": [
      {"en": "Remember to call her.", "bn": "Remember to call her."},
      {"en": "Remember calling her.", "bn": "Remember calling her."},
      {"en": "Remember call her.", "bn": "Remember call her."},
      {"en": "Remember for calling her.", "bn": "Remember for calling her."}
    ],
    "answer": 1,
    "why": {
      "en": "\"Remember + gerund\" recalls a memory of a past action. \"Remember + infinitive\" is a reminder not to forget a future task.",
      "bn": "\"Remember + gerund\" past action-এর memory recall করে। \"Remember + infinitive\" future task ভুলে না যাওয়ার reminder।"
    }
  },
